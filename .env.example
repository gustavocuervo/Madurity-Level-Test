# This application uses PostgreSQL / Cloud SQL for persistent, durable data storage.
# Environment variables are automatically provided by the platform at runtime, but are listed here for local development.

# Application connection info (Read/Write user)
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_HOST=

# Schema management connection info (Admin user used by Drizzle Kit)
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=
